<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fillViewport="true"
    android:background="#EAF4FF"
    >
    <!-- Contenedor para superposición -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- FONDO AZUL CURVO -->
        <!-- FONDO AZUL CURVO -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="fitXY"
            android:src="@drawable/bg_profile_wave"
            android:translationY="0dp" />


        <!-- CONTENIDO SUPERPUESTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/tvTituloPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="start"
                android:paddingStart="8dp"
                android:text="Perfil"
                android:textColor="#0D47A1"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- HEADER ICONO + INFO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="30dp">

                <!-- AVATAR -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_white"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/imgPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Icono de perfil"
                        android:src="@drawable/ic_profile"
                        app:tint="#1565C0" />
                </FrameLayout>

                <!-- NOMBRE + CORREO -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreUsuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre del usuario"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCorreo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:text="correo@ejemplo.com"
                        android:textColor="#E3F2FD"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnCerrarSesion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:padding="0dp"
                        android:text="CERRAR SESION"
                        android:textColor="@color/blue_light_bg"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- DESCRIPCIÓN -->
            <TextView
                android:id="@+id/tvDescripcionPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="Consulta y actualiza tus datos personales y mantenen tu perfil siempre al día."
                android:textColor="#1A237E"
                android:textSize="14sp" />

            <!-- BOTÓN ACTUALIZAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnGuardarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="4dp"
                    android:background="@android:color/transparent"
                    android:gravity="start"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:text="Actualizar mis datos"
                    android:textColor="#78A0C8"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#1E88E5" />
            </LinearLayout>

            <!-- TÍTULO PUBLICACIONES -->
            <TextView
                android:id="@+id/tvPost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start"
                android:paddingStart="8dp"
                android:text="Publicaciones"
                android:textColor="#1975D1"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- FEED -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_historial" />

        </LinearLayout>

    </FrameLayout>

</androidx.core.widget.NestedScrollView>
