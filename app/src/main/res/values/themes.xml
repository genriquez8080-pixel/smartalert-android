<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SmartAlert" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Colores básicos, ajusta según tus colores -->
        <item name="colorPrimary">@android:color/holo_blue_dark</item>
        <item name="colorPrimaryVariant">@android:color/holo_blue_bright</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Colores por defecto de textos -->
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorHint">@android:color/darker_gray</item>
        <item name="android:editTextColor">@android:color/black</item>

        <!-- Esto evita warnings en algunas APIs -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>

</resources>
